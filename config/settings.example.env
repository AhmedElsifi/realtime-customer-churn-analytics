# =========================================================
# Copy this file to `.env` and fill in real values.
# NEVER commit `.env`.
#
# No Docker: everything runs on the local machine.
# =========================================================

# ---------------- Kafka ----------------
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

KAFKA_RAW_TOPIC=customer_raw
KAFKA_PROCESSED_TOPIC=customer_processed
KAFKA_INVALID_TOPIC=customer_invalid

KAFKA_PRODUCER_CLIENT_ID=churn-producer
KAFKA_CONSUMER_GROUP_ID=churn-spark

# Producer pacing (simulates real-time stream)
PRODUCER_RECORDS_PER_SECOND=5
PRODUCER_TOTAL_RECORDS=10000
PRODUCER_DIRTY_RECORD_RATIO=0.05

# ---------------- Apache NiFi ----------------
NIFI_URL=https://localhost:8443
NIFI_USERNAME=admin
NIFI_PASSWORD=changeme

# ---------------- Spark ----------------
SPARK_MASTER=local[*]
SPARK_APP_NAME=CustomerChurnAnalytics
SPARK_CHECKPOINT_DIR=./checkpoints
SPARK_TRIGGER_INTERVAL=10 seconds
SPARK_WATERMARK=2 minutes

# ---------------- MongoDB ----------------
MONGO_URI=mongodb://localhost:27017
MONGO_DB=churn_db
MONGO_COLLECTION_CUSTOMERS=customers
MONGO_COLLECTION_CHURN_ANALYTICS=churn_analytics
MONGO_COLLECTION_WINDOW_ANALYTICS=churn_time_windows

# ---------------- Misc ----------------
LOG_LEVEL=INFO